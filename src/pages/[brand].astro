---
import Layout from '../layouts/Layout.astro';
import BrandPageLayout from '../components/BrandPageLayout';
import { BRAND_PAGES_DATA } from '../data/content';

const { brand } = Astro.params;
const brandData = BRAND_PAGES_DATA[brand];

if (!brandData) {
  return Astro.redirect('/404');
}
---
<Layout 
  title={`${brandData.name} RO Service Bangalore | 60-Min Doorstep`}
  description={`Get certified ${brandData.name} RO repair in Bangalore. 60-min doorstep service, genuine parts, 30-day warranty.`}
>
  <BrandPageLayout brand={brandData} client:load />
</Layout>