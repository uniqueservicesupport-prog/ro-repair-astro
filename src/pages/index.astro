---
import Layout from '../layouts/Layout.astro';
import { BrandPageLayout } from '../components/BrandPageLayout';
import { BRAND_PAGES_DATA } from '../data/content';

const homepageData = BRAND_PAGES_DATA['ro-service-24x7'] || Object.values(BRAND_PAGES_DATA)[0];
---
<Layout 
  title="RO Service Center Bangalore | 60-Min Doorstep Repair"
  description="Bangalore's most trusted RO water purifier repair service. Same-day doorstep service, genuine filters, 30-day warranty."
>
  <BrandPageLayout brand={homepageData} client:load />
</Layout>